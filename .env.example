# Path on the host to mount as the download/music directory
MUSIC_DIR=/media/music

# Port to expose the frontend on the host
APP_PORT=8085

# Port to expose the MCP server on the host
MCP_PORT=8086

# Secret token required to access the MCP server
MCP_TOKEN=qobuz_mcp_secure_secret_token_change_me

ALLOWED_HOSTS=localhost,localhost:8086,127.0.0.1,127.0.0.1:8086

# Web UI Authentication
# Set these to enable the login screen (leave blank to disable auth)
APP_USERNAME=your_username
APP_PASSWORD=your_secure_password
# Generate with: openssl rand -hex 32
JWT_SECRET=your_random_secret_here
